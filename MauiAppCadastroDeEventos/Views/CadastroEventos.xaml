<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppCadastroDeEventos.CadastroEventos"
             NavigationPage.HasNavigationBar="False"
             Title="Cadastro De Eventos">
    <VerticalStackLayout VerticalOptions="Center"
                         Padding="5">
        <Label 
            Text="Cadastro de Eventos"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            Margin="5"
            Style="{StaticResource Headline}"/>

        <Frame Margin="5">
            <VerticalStackLayout>
                <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto"
                      ColumnDefinitions="*, *, 0.5*"
                      RowSpacing="3"
                      >

                    <Label Text="Nome do evento: "
                           Margin="10"
                           Grid.Row="0" Grid.Column="0"/>
                    <Entry Placeholder="Ex.: Casamento da Bruna"
                           x:Name="ent_nome"
                           Grid.Row="0" Grid.Column="1"/>

                    <Label Text="Data de início: "
                           Margin="10"
                           Grid.Row="1" Grid.Column="0"/>
                    <DatePicker x:Name="dtpck_inicio"
                            DateSelected="dtpck_inicio_DateSelected"
                            Format="dd/MM/yyyy"
                            Grid.Row="1" Grid.Column="1"/>

                    <Label Text="Data de término: "
                           Margin="10"
                           Grid.Row="2" Grid.Column="0"/>
                    <DatePicker x:Name="dtpck_termino"
                           Format="dd/MM/yyyy"
                           Grid.Row="2" Grid.Column="1"/>
             
                    <Label Text="Local do evento: "
                           Margin="10"
                           Grid.Row="3" Grid.Column="0"/>
                    <Entry Placeholder="Ex.: Salão de Festas" 
                           x:Name="ent_local"
                           Grid.Row="3" Grid.Column="1"/>

                    <Label Text="Número de participantes: "
                           Margin="10"
                           Grid.Row="4" Grid.Column="0"/>
                    <Label Text="{Binding Value}"
                           BindingContext="{x:Reference stp_participantes}"
                           Margin="10"
                           Grid.Row="4" Grid.Column="1"
                           HorizontalOptions="Center"/>
                    <Stepper x:Name="stp_participantes"
                             Minimum="1"
                             Increment="1"
                             Grid.Row="4" Grid.Column="2"/>

                    <Label Text="Custo por participante: "
                           Margin="10"
                           Grid.Row="5" Grid.Column="0"/>
                    <Entry Placeholder="Ex.: 100"
                           Keyboard="Numeric"
                           x:Name="ent_custo"
                           Grid.Row="5" Grid.Column="1"/>
                </Grid>
            </VerticalStackLayout>
        </Frame>

            <Button Text="Avançar" 
                    HorizontalOptions="Center"
                    Clicked="Button_Clicked"
                    Margin="5"/>

    </VerticalStackLayout>
</ContentPage>